# Local development: copy this file to .env.local. Do not commit that file.
# Production: configure the same values in Vercel Project Settings -> Environment Variables.
# Google service-account credentials are server-only; never prefix them with NEXT_PUBLIC_.
GOOGLE_SHEETS_CLIENT_EMAIL=service-account@example-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_ROSTER_SPREADSHEET_ID=replace-with-spreadsheet-id
GOOGLE_ROSTER_PORTRAIT_FOLDER_ID=replace-with-drive-folder-id

# Canonical public URL used for metadata, sitemap, robots, and structured data.
# Use http://localhost:3000 locally and the public HTTPS origin in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
